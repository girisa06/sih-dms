DATABASE_URL=postgresql+psycopg2://dms_user:dms_password@localhost:5432/dms_db
# Required. No default is provided in code — the app will fail to start without this set.
# Generate a real value locally, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=REPLACE_WITH_LOCALLY_GENERATED_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
# Base URL this backend calls itself on to trigger POST /ai/process/{document_id}
# after upload. Not yet implemented by Person 3 - the call is caught/ignored if it fails.
AI_PROCESS_BASE_URL=http://localhost:8000
